# ─────────────────────────────────────────────────────────────
# Conexión de respaldo (SOLO desarrollo)
# Se usa automáticamente si la conexión principal (XAMPP) es rechazada.
# Copia este archivo como .env.local y ajusta estos valores a tu MySQL local.
# Deja DB_FALLBACK_HOST vacío para desactivar el respaldo.
# ─────────────────────────────────────────────────────────────
# DB_FALLBACK_HOST=127.0.0.1
# DB_FALLBACK_PORT=3306
# DB_FALLBACK_NAME=materials
# DB_FALLBACK_USER=root
# DB_FALLBACK_PASS=
# DB_FALLBACK_SOCKET=
